# TwistForge AI — env template
# Copy to .env.local and fill in real values. Never commit secrets.

# Gemini (server-only, no NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Supabase (public values are safe for browser; service role stays server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: set to 1 to enable the Google OAuth button (requires Google provider in Supabase Auth)
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=
